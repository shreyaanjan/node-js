<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container">
        <h2 class="my-2">Student Details</h2>
        <form action="/add-students" method="post">
            <div class="d-flex align-items-center gap-3">
                <div class="mb-3">
                    <label for="name" class="form-label">Name : </label>
                    <input type="text" class="form-control" id="name" name="name">
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email : </label>
                    <input type="email" class="form-control" id="email" name="email">
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="mb-3">
                    <label for="age" class="form-label">Age : </label>
                    <input type="number" class="form-control" id="age" name="age">
                </div>
                <div class="mb-3">
                    <label for="city" class="form-label">City : </label>
                    <select for="city" name="city" class="form-select w-100">
                        <option selected>Select City</option>
                        <option value="Surat">Surat</option>
                        <option value="Ahmedabad">Ahmedabad</option>
                        <option value="Navsari">Navsari</option>
                        <option value="Rajkot">Rajkot</option>
                        <option value="Vapi">Vapi</option>
                    </select>
                </div>
            </div>
            <button class="btn btn-primary">Submit</button>
        </form>
        <table class="table table-striped my-3">
            <thead>
                <tr>
                    <th>Number</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Age</th>
                    <th>City</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% students.map((stu, idx)=> { %>
                    <tr>
                        <td>
                            <%= idx+1 %>
                        </td>
                        <td>
                            <%= stu.name %>
                        </td>
                        <td>
                            <%= stu.email %>
                        </td>
                        <td>
                            <%= stu.age %>
                        </td>
                        <td>
                            <%= stu.city %>
                        </td>
                        <td>
                            <button class="btn btn-success">Edit</button>
                            <button onclick="deleteStudent('<%= stu.id %>')" class="btn btn-danger">Delete</button>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const deleteStudent = (id) => {
        Swal.fire({
            title: "Are you sure you want to delete the info?",
            showCancelButton: true,
            confirmButtonText: "Delete",
            denyButtonText: `Don't delete`
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = `/delete-student?deleteId=${id}`
            } else if (result.isDenied) {
                Swal.fire("Student not deleted.");
            }
        });
    }
</script>

</html>